    "    def __init__(self,length,width):\n",
    "        self.length=length\n",
    "        self.width=width\n",
    "    def rect_area(self):\n",
    "        return f\"The area of given rectangle is {self.length * self.width}.\"\n",
    "rect=Rectangle(30,15)\n",
    "print(rect.rect_area())"
